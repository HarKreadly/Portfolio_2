<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="avatarGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8B5CF6;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background Circle -->
  <circle cx="200" cy="200" r="200" fill="url(#avatarGradient)"/>

  <!-- Person Silhouette -->
  <circle cx="200" cy="140" r="50" fill="#ffffff" opacity="0.9"/>
  <ellipse cx="200" cy="280" rx="80" ry="60" fill="#ffffff" opacity="0.9"/>

  <!-- Eyes -->
  <circle cx="185" cy="130" r="3" fill="#3B82F6"/>
  <circle cx="215" cy="130" r="3" fill="#3B82F6"/>

  <!-- Smile -->
  <path d="M 185 145 Q 200 155 215 145" stroke="#3B82F6" stroke-width="2" fill="none"/>

  <!-- Decorative Elements -->
  <circle cx="120" cy="120" r="4" fill="#ffffff" opacity="0.6"/>
  <circle cx="280" cy="280" r="6" fill="#ffffff" opacity="0.6"/>
  <circle cx="320" cy="150" r="3" fill="#ffffff" opacity="0.4"/>
</svg>
