<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="ecommerceGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="400" height="300" fill="url(#ecommerceGradient)"/>

  <!-- Shopping Cart Icon -->
  <path d="M 100 150 L 120 150 L 125 180 L 300 180 L 290 120 L 110 120 Z" fill="#ffffff" opacity="0.9"/>
  <circle cx="130" cy="200" r="15" fill="#ffffff" opacity="0.8"/>
  <circle cx="280" cy="200" r="15" fill="#ffffff" opacity="0.8"/>

  <!-- Product Cards -->
  <rect x="50" y="50" width="60" height="40" fill="#ffffff" opacity="0.7" rx="4"/>
  <rect x="130" y="50" width="60" height="40" fill="#ffffff" opacity="0.7" rx="4"/>
  <rect x="210" y="50" width="60" height="40" fill="#ffffff" opacity="0.7" rx="4"/>
  <rect x="290" y="50" width="60" height="40" fill="#ffffff" opacity="0.7" rx="4"/>

  <!-- Decorative Elements -->
  <circle cx="80" cy="80" r="3" fill="#ffffff" opacity="0.6"/>
  <circle cx="350" cy="250" r="4" fill="#ffffff" opacity="0.6"/>
</svg>
