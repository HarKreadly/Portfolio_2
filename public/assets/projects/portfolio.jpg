<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="portfolioGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8B5CF6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#7C3AED;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="400" height="300" fill="url(#portfolioGradient)"/>

  <!-- Browser Window -->
  <rect x="50" y="40" width="300" height="200" fill="#ffffff" opacity="0.9" rx="8"/>
  <rect x="50" y="40" width="300" height="30" fill="#f0f0f0" opacity="0.9" rx="8"/>

  <!-- Browser Controls -->
  <circle cx="70" cy="55" r="4" fill="#ff5f57"/>
  <circle cx="90" cy="55" r="4" fill="#ffbd2e"/>
  <circle cx="110" cy="55" r="4" fill="#28ca42"/>

  <!-- Navigation -->
  <rect x="70" y="80" width="60" height="8" fill="#8B5CF6" opacity="0.8" rx="4"/>
  <rect x="140" y="80" width="80" height="8" fill="#e0e0e0" opacity="0.6" rx="4"/>
  <rect x="230" y="80" width="100" height="8" fill="#e0e0e0" opacity="0.6" rx="4"/>

  <!-- Hero Section -->
  <rect x="70" y="100" width="260" height="60" fill="#f8f9fa" opacity="0.8"/>

  <!-- Profile Picture -->
  <circle cx="100" cy="130" r="20" fill="#8B5CF6" opacity="0.8"/>

  <!-- Text Lines -->
  <rect x="130" y="120" width="180" height="4" fill="#e0e0e0" opacity="0.6"/>
  <rect x="130" y="135" width="150" height="4" fill="#e0e0e0" opacity="0.6"/>
  <rect x="130" y="150" width="200" height="4" fill="#e0e0e0" opacity="0.6"/>

  <!-- Project Cards -->
  <rect x="70" y="180" width="60" height="40" fill="#10B981" opacity="0.7" rx="4"/>
  <rect x="140" y="180" width="60" height="40" fill="#3B82F6" opacity="0.7" rx="4"/>
  <rect x="210" y="180" width="60" height="40" fill="#F59E0B" opacity="0.7" rx="4"/>
  <rect x="280" y="180" width="60" height="40" fill="#EF4444" opacity="0.7" rx="4"/>
</svg>
