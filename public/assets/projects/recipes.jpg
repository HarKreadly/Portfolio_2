<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="recipeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F97316;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#EA580C;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="400" height="300" fill="url(#recipeGradient)"/>

  <!-- Plate -->
  <circle cx="200" cy="180" r="80" fill="#ffffff" opacity="0.9"/>

  <!-- Food Items -->
  <!-- Pizza -->
  <circle cx="170" cy="150" r="25" fill="#D97706" opacity="0.8"/>
  <circle cx="170" cy="150" r="20" fill="#F59E0B" opacity="0.9"/>
  <!-- Pepperoni -->
  <circle cx="165" cy="145" r="3" fill="#DC2626"/>
  <circle cx="175" cy="155" r="3" fill="#DC2626"/>
  <circle cx="160" cy="160" r="3" fill="#DC2626"/>

  <!-- Salad -->
  <ellipse cx="220" cy="160" rx="20" ry="15" fill="#10B981" opacity="0.8"/>
  <ellipse cx="225" cy="155" rx="15" ry="10" fill="#059669" opacity="0.8"/>

  <!-- Bread -->
  <rect x="180" y="190" width="40" height="15" fill="#92400E" opacity="0.8" rx="7"/>

  <!-- Steam -->
  <path d="M 160 130 Q 155 120 160 110" stroke="#ffffff" stroke-width="2" fill="none" opacity="0.7"/>
  <path d="M 180 125 Q 185 115 180 105" stroke="#ffffff" stroke-width="2" fill="none" opacity="0.7"/>
  <path d="M 220 130 Q 225 120 220 110" stroke="#ffffff" stroke-width="2" fill="none" opacity="0.7"/>

  <!-- Recipe Cards -->
  <rect x="50" y="50" width="60" height="40" fill="#ffffff" opacity="0.8" rx="4"/>
  <rect x="130" y="50" width="60" height="40" fill="#ffffff" opacity="0.8" rx="4"/>
  <rect x="210" y="50" width="60" height="40" fill="#ffffff" opacity="0.8" rx="4"/>
  <rect x="290" y="50" width="60" height="40" fill="#ffffff" opacity="0.8" rx="4"/>

  <!-- Search Bar -->
  <rect x="70" y="250" width="260" height="25" fill="#ffffff" opacity="0.9" rx="12"/>
  <circle cx="330" cy="262" r="8" fill="#F97316"/>

  <!-- Decorative Elements -->
  <circle cx="80" cy="120" r="3" fill="#ffffff" opacity="0.6"/>
  <circle cx="350" cy="200" r="4" fill="#ffffff" opacity="0.6"/>
  <circle cx="120" cy="80" r="2" fill="#ffffff" opacity="0.5"/>
</svg>
